# ─────────────────────────────────────────────────────────────
# SanshthaSetu — root .env.example
# Copy this file to .env in /backend and /frontend and fill in
# real values. Never commit .env files.
# ─────────────────────────────────────────────────────────────

# ── Backend ──────────────────────────────────────────────────

# PostgreSQL connection string (Neon free tier).
# Must include ?sslmode=require for Neon.
DATABASE_URL=postgresql+psycopg2://user:password@host/dbname?sslmode=require

# Separate database used only by pytest.
# Can be a Neon branch or a local Docker Postgres.
TEST_DATABASE_URL=postgresql+psycopg2://user:password@host/testdb?sslmode=require

# JWT signing secret — minimum 32 characters, random string.
JWT_SECRET=change_me_to_a_random_32_char_string_here

# JWT expiry in hours (default: 24).
JWT_EXPIRE_HOURS=24

# Comma-separated list of allowed frontend origins (no trailing slash).
# Example: http://localhost:5173,https://your-app.vercel.app
CORS_ORIGINS=http://localhost:5173

# Application environment: development | production
ENVIRONMENT=development

# ── Frontend ─────────────────────────────────────────────────

# Backend API base URL — no trailing slash.
VITE_API_BASE_URL=http://localhost:8000
