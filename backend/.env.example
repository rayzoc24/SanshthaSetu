# SanshthaSetu — backend environment variables
# Copy to .env and fill in real values. Never commit .env.

# PostgreSQL connection string (Neon). Include ?sslmode=require.
DATABASE_URL=postgresql+psycopg2://user:password@host/dbname?sslmode=require

# Separate Postgres used only by pytest (Neon branch or local Docker).
TEST_DATABASE_URL=postgresql+psycopg2://user:password@host/testdb?sslmode=require

# JWT signing secret — minimum 32 random characters.
JWT_SECRET=change_me_to_a_random_32_char_string_here

# JWT token expiry in hours.
JWT_EXPIRE_HOURS=24

# Comma-separated list of allowed frontend origins (no trailing slash).
CORS_ORIGINS=http://localhost:5173

# Application environment: development | production
ENVIRONMENT=development
